PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
# Dedicated key material for AES-256-GCM encrypted administrator TOTP secrets.
MFA_ENCRYPTION_KEY=replace_with_a_long_random_secret
MFA_ISSUER=GentsConcerts
# Keep false by default; only enable as an explicitly controlled finance recovery path.
ALLOW_EMAIL_STEP_UP_FALLBACK=false

# MTN Mobile Money
MTN_ENVIRONMENT=sandbox
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_CALLBACK_URL=https://your-production-url/api/payments/callback
MOMO_CONSUMER_KEY=your_momo_consumer_key
MOMO_CONSUMER_SECRET=your_momo_consumer_secret
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_API_USER_ID=your_momo_api_user_id
MTN_MOMO_CALLBACK_TOKEN=replace_with_a_rotated_private_callback_token
PAYMENT_ENABLED=false
ALLOW_FREE_TICKET_BYPASS=true

# Only set these from a verified backup/restore system; otherwise the API
# intentionally reports not_configured/unknown rather than a false green state.
BACKUP_STATUS=not_configured
LAST_BACKUP_AT=
RECOVERY_HEALTH=unknown

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="GentsConcerts" <noreply@gentsconcerts.com>

# Frontend
FRONTEND_URL=https://gentsconcerts.netlify.app

# Push Notifications (Expo)
EXPO_PUSH_ENABLED=true

# File Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Node Environment
NODE_ENV=production

# Durable media persistence
# Render disks are ephemeral; keep this true unless using S3/Cloudinary instead.
PERSIST_MEDIA_IN_MONGODB=true
